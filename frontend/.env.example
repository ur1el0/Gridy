# Gridy Frontend Environment Variables

# Base URL for the Django REST Framework API.
# Development: http://127.0.0.1:8000/api/v1
# Production (same-origin proxy): /api/v1
# Production (cross-origin / custom domain): https://api.gridy.ph/api/v1 or https://<backend-render-app>.onrender.com/api/v1
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

