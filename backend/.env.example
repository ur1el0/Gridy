# Django Core Settings
SECRET_KEY=your_secret_key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://*.vercel.app,http://localhost:5173

# Exact browser frontend origins allowed to access the API.
# Set the production frontend origin explicitly in deployment settings.
CORS_ALLOWED_ORIGINS=http://localhost:5173

FRONTEND_URL=http://localhost:5173

# Refresh token cookie SameSite policy. Defaults to Strict for same-origin or reverse-proxy setups.
# Lax works only for compatible same-site setups (e.g. subdomains of the same registrable domain).
# Cross-site API requests (different domains without a reverse proxy) require SameSite=None and SECURE (HTTPS).
REFRESH_COOKIE_SAMESITE=Strict

# Required for admin registration. Replace with a unique, high-entropy secret.
ADMIN_REGISTRATION_PASSKEY=

# Database Configuration
DATABASE_URL=

# Local tests use SQLite by default; set False to test PostgreSQL row locking.
GRIDY_TEST_USE_SQLITE=True

# Cloudinary Configuration (required in production for persistent media storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Configuration
# Production requires a valid Firebase service-account JSON file and absolute path.
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=

# Production PostgreSQL Database Configurations (Optional fallback)
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5433

SENTRY_DSN=

# Email SMTP Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Defaults to EMAIL_HOST_USER when blank. Production must configure SMTP credentials.
DEFAULT_FROM_EMAIL=
