# Django Core Settings
SECRET_KEY=your_secret_key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,*

# Database Configuration
DATABASE_URL=

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
