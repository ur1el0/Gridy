# Django Core Settings
SECRET_KEY=your_secret_key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://*.vercel.app,http://localhost:5173

# Exact browser frontend origins allowed to access the API.
# Set the production frontend origin explicitly in deployment settings.
CORS_ALLOWED_ORIGINS=http://localhost:5173

FRONTEND_URL=http://localhost:5173

# Required for admin registration. Replace with a unique, high-entropy secret.
ADMIN_REGISTRATION_PASSKEY=

# Database Configuration
DATABASE_URL=

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Configuration
FIREBASE_SERVICE_ACCOUNT_JSON_PATH=

# Production PostgreSQL Database Configurations (Optional fallback)
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5433

SENTRY_DSN=

# Email SMTP Configuration
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=